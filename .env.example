# Copy this file to ".env" and fill in your values. Never commit the real .env.

# ── Email (Gmail) ────────────────────────────────────────────
# The Gmail address that SENDS the notification emails.
GMAIL_USER=cashbackagency1@gmail.com

# A Google "App Password" (16 chars) for that account — NOT your normal password.
# Create one at: https://myaccount.google.com/apppasswords  (needs 2-Step Verification)
GMAIL_APP_PASSWORD=your_16_char_app_password

# Where booking / contact notifications are delivered.
TO_EMAIL=cashbackagency1@gmail.com

# ── Admin ────────────────────────────────────────────────────
# Token that protects the admin submissions page (/admin?token=...).
ADMIN_TOKEN=cashback2026

# Port the contact server runs on (optional)
PORT=3001
